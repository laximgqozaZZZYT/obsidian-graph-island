  "sortRules": [{ "key": "label", "order": "asc" }],
  "nodeRules": [],
  "nodeShapeRules": [
    { "match": "isTag", "shape": "diamond" },
    { "match": "default", "shape": "circle" }
  ],
  "timelineKey": "date",
  "showEdgeLabels": true,
  "showMinimap": false,
  "groupBy": "tag:?",
  "groupByRules": null,
  "groupMinSize": 3,
  "groupFilter": "",
  "collapsedGroups": [],

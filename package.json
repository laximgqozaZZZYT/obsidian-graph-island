{
  "name": "obsidian-graph-island",
  "version": "0.6.0",
  "description": "Graph Island — Multiple graph visualization layouts for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=e2e/obsidian-e2e.config.ts",
    "test:e2e:smoke": "npx playwright test --config=e2e/cdp-smoke.config.ts",
    "test:e2e:mid": "npx playwright test --config=e2e/cdp-mid.config.ts",
    "test:e2e:full": "npx playwright test --config=e2e/cdp-e2e.config.ts",
    "test:e2e:harness": "npx playwright test --config=playwright.config.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/"
  },
  "keywords": [
    "obsidian",
    "graph",
    "visualization"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-shape": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "obsidian": "latest",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.1.0",
    "d3-zoom": "^3.0.0"
  }
}

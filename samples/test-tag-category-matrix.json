  "orbitAutoRotate": false,
  "autoFit": true,
  "showDurationBars": false,
  "timelineEndKey": "",
  "showGuideLines": false,
  "guideLineMode": "per-group",
  "showGroupGrid": true,
  "timelineOrderFields": "",
  "dataviewQuery": "",
  "gridTableMode": true,
  "gridShowHeaders": true,
  "gridCellShading": true,
  "gridStyle": "table",
  "coordinateLayout": {
    "system": "cartesian",
    "axis1": { "source": { "kind": "field", "field": "tag" }, "transform": { "kind": "linear", "scale": 1 } },
    "axis2": { "source": { "kind": "field", "field": "category" }, "transform": { "kind": "linear", "scale": 1 } },
    "perGroup": false,
    "grid": {
      "axis1Grid": {
        "positions": { "kind": "field", "field": "tag" },
        "shape": { "kind": "line" },
        "ticks": { "show": true, "labels": { "kind": "field", "field": "tag" } }
      },
      "axis2Grid": {
        "positions": { "kind": "field", "field": "category" },
        "shape": { "kind": "line" },
        "ticks": { "show": true, "labels": { "kind": "field", "field": "category" } }
      },
      "style": "table",
      "cellShading": true
    }
  }
